# Copy this file to `.env` and fill in the real values. `.env` is git-ignored.

# --- Which AI provider to use: openai | gemini ---
AI_PROVIDER=openai

# --- Gemini (Google AI Studio) — has a free tier, handy for testing ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- OpenAI ---
# Key: https://platform.openai.com/api-keys
# The task is tiny, so the cheapest tier is plenty. The model never affects
# price accuracy — that is computed deterministically in the backend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# --- E-mail (Resend) ---
# Free key at https://resend.com . With no verified domain, leave
# LEAD_EMAIL_FROM as the onboarding@resend.dev test sender.
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=Aqua System <onboarding@resend.dev>

# Offer to e-mail the quote to the CUSTOMER as well. Needs a verified sending
# domain in Resend — until then leave this off (the owner is still notified).
EMAIL_OFFER=off

# --- Google Sheet logging (optional) ---
# Deployed Google Apps Script web-app URL (see README → "Leads → Google Sheet").
# Leave empty to disable; e-mail still works.
SHEETS_WEBHOOK_URL=
